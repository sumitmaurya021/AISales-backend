# LeadFlow AI - Backend Environment Configuration Template
PORT=3000
RAILS_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root

# Redis & Background Workers
